{
  "name": "material-tailscale",
  "productName": "Material Tailscale",
  "version": "1.0.0",
  "description": "A Material 3 Expressive desktop manager for every Tailscale feature: peers, exit nodes, subnet routes, Serve, Funnel, Taildrop, Tailnet Lock, Taildrive, DNS, certificates and the full admin API.",
  "main": "src/main/main.js",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "homepage": "https://ding-ding-projects.github.io/material-Tailscale/",
  "repository": "https://github.com/Ding-Ding-Projects/material-Tailscale",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:info": "node scripts/build-info.mjs",
    "build": "npm run build:info && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package:win": "node scripts/package-win.mjs",
    "count-lines": "node scripts/count-lines.mjs",
    "screenshots": "node scripts/capture.mjs",
    "gen:api": "node scripts/gen-api-catalog.mjs",
    "record": "node scripts/record.mjs",
    "clip-matrix": "node scripts/clip-matrix.mjs",
    "gen:postman": "node scripts/gen-postman.mjs",
    "wiki": "node scripts/sync-wiki.mjs",
    "check:instructions": "node scripts/check-instructions-lock.mjs",
    "design:parity": "node scripts/design-parity.mjs",
    "design:boards": "node scripts/design-boards.mjs",
    "design:reference": "electron tools/design-reference",
    "sweep": "node scripts/sweep.mjs",
    "gen:completeness": "node scripts/gen-completeness.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "dompurify": "^3.2.6",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "isomorphic-git": "^1.30.1",
    "jsqr": "^1.4.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "axe-core": "4.14.0",
    "electron": "^37.2.0",
    "electron-winstaller": "^5.4.0",
    "esbuild": "^0.25.5",
    "gifenc": "^1.0.3",
    "js-yaml": "^4.3.2",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  }
}
