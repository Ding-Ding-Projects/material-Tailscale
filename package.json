{
  "name": "material-tailscale",
  "productName": "Material Tailscale",
  "version": "1.0.0",
  "description": "A Material 3 Expressive desktop manager for every Tailscale feature: peers, exit nodes, subnet routes, Serve, Funnel, Taildrop, Tailnet Lock, Taildrive, DNS, certificates and the full admin API.",
  "main": "src/main/main.js",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "homepage": "https://ding-ding-projects.github.io/material-Tailscale/",
  "repository": "https://github.com/Ding-Ding-Projects/material-Tailscale",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:info": "node scripts/build-info.mjs",
    "build": "npm run build:info && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package:win": "node scripts/package-win.mjs",
    "count-lines": "node scripts/count-lines.mjs",
    "screenshots": "node scripts/capture.mjs",
    "gen:api": "node scripts/gen-api-catalog.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "electron-squirrel-startup": "^1.0.1",
    "isomorphic-git": "^1.30.1",
    "jsqr": "^1.4.0",
    "marked": "^15.0.12",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^37.2.0",
    "esbuild": "^0.25.5",
    "js-yaml": "^4.3.2",
    "sharp": "^0.34.5",
    "png-to-ico": "^2.1.8",
    "electron-winstaller": "^5.4.0"
  }
}
